{#- "How a project works" step timeline (SPEC 5.3), from data/process.json.
    Vertical on mobile, horizontal from 1024px. -#}
{% macro howItWorks(steps, headingLevel = 3, compact = false) -%}
<ol class="timeline{% if compact %} timeline--compact{% endif %}">
  {%- for step in steps %}
  <li class="timeline__step">
    <span class="timeline__num" aria-hidden="true">{{ loop.index }}</span>
    <h{{ headingLevel }} class="timeline__title">{{ step.name }}</h{{ headingLevel }}>
    <p class="timeline__text">{{ step.text | tbd | safe }}</p>
  </li>
  {%- endfor %}
</ol>
{%- endmacro %}
