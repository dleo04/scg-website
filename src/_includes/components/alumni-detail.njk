{#- Alumni bio: the single source for the drawer (components/alumni-dialog.njk) and the page
    /alumni/<id>/. Portrait (4:5, framed on the face), name, class, majors, role/org, LinkedIn
    button, then the bio paragraphs exactly as in data/alumni.json. titleLevel: 1 on the page,
    2 in the drawer. -#}
{% macro alumniDetail(p, titleLevel = 2) -%}
<article class="alum-detail">
  <div class="alum-detail__photo">
    {%- if p.headshot and p.headshot.portrait %}
    <img src="{{ p.headshot.portrait.src }}" width="{{ p.headshot.portrait.width }}" height="{{ p.headshot.portrait.height }}" alt="Photo of {{ p.name }}"{% if titleLevel == 2 %} loading="lazy"{% endif %} decoding="async">
    {%- else %}
    <span class="avatar avatar--initials" role="img" aria-label="{{ p.name }}">{{ p.initials }}</span>
    {%- endif %}
  </div>
  <div class="alum-detail__text">
    <h{{ titleLevel }} class="alum-detail__name" data-detail-title tabindex="-1">{{ p.name }}</h{{ titleLevel }}>
    {%- if p.classLabel %}<p class="alum-detail__class">{{ p.classLabel }}</p>{% endif %}
    {%- if p.majors.length %}<p class="alum-detail__majors"><span class="visually-hidden">Majors: </span>{{ p.majors | join(", ") }}</p>{% endif %}
    {%- if p.current_role or p.current_org %}<p class="alum-detail__role">{{ p.current_role }}{% if p.current_role and p.current_org %}, {% endif %}{{ p.current_org }}</p>{% endif %}
    {%- if p.linkedin %}
    <p class="alum-detail__links"><a class="btn btn--secondary btn--sm alum-detail__linkedin" href="{{ p.linkedin }}" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.6 8.65 21 11.2 21 14.5V21h-4v-5.8c0-1.4-.03-3.2-1.95-3.2-1.95 0-2.25 1.52-2.25 3.1V21H9z"/></svg>LinkedIn<span class="visually-hidden"> profile of {{ p.name }} (opens in a new tab)</span></a></p>
    {%- endif %}
    <div class="alum-detail__bio">
      {%- for para in p.bio %}<p>{{ para }}</p>{% endfor %}
    </div>
  </div>
</article>
{%- endmacro %}
