{%- from "components/ui.njk" import tbdBlock, media, chip with context -%}
{#- Full project story (SPEC 6). The single source for both the dialog and the
    standalone /projects/<id>/ page. Missing fields render as visible placeholders.
    titleLevel: 1 on the standalone page, 2 inside the dialog. -#}
{% macro projectDetail(p, titleLevel = 2) -%}
{%- set h = titleLevel + 1 -%}
<article class="project-detail">
  <div class="project-detail__media">
    {{ media(p.image, p.image_alt, "PHOTO: " ~ p.title ~ " team (16:9)") }}
  </div>
  <header class="project-detail__head">
    <h{{ titleLevel }} class="project-detail__title" data-detail-title tabindex="-1">{{ p.title }}</h{{ titleLevel }}>
    <p class="project-detail__tagline">{{ p.tagline | tbd | safe }}</p>
    <dl class="project-detail__meta">
      <div><dt>Client</dt><dd>{{ p.client | tbd | safe }}</dd></div>
      <div><dt>Semester</dt><dd>{{ p.semester | tbd | safe }}</dd></div>
      <div><dt>Client type</dt><dd>{{ p.client_type | tbd | safe }}</dd></div>
    </dl>
  </header>

  <section class="project-detail__section">
    <h{{ h }}>Challenge</h{{ h }}>
    {%- if p.challenge | isTbd %}{{ tbdBlock("Challenge coming soon", p.challenge or "[TBD: the client's challenge]") }}
    {%- else %}<p>{{ p.challenge | tbd | safe }}</p>{% endif %}
  </section>

  <section class="project-detail__section">
    <h{{ h }}>Scope</h{{ h }}>
    {%- if p.scope | isTbd %}{{ tbdBlock("Scope coming soon", "[TBD: deliverables from the Statement of Work]") }}
    {%- else %}
    <ul class="checklist">{% for s in p.scope %}<li>{{ s | tbd | safe }}</li>{% endfor %}</ul>
    {%- if p.scope_detail %}<p class="project-detail__note">{{ p.scope_detail | tbd | safe }}</p>{% endif %}
    {%- endif %}
  </section>

  <section class="project-detail__section">
    <h{{ h }}>Approach</h{{ h }}>
    {%- if p.approach | isTbd %}{{ tbdBlock("Approach coming soon", p.approach or "[TBD: how the team worked]") }}
    {%- else %}<p>{{ p.approach | tbd | safe }}</p>{% endif %}
  </section>

  <section class="project-detail__section">
    <h{{ h }}>Outcome</h{{ h }}>
    {%- if p.outcome | isTbd %}{{ tbdBlock("Outcome coming soon", p.outcome or "[TBD: results for the client]") }}
    {%- else %}<p>{{ p.outcome | tbd | safe }}</p>{% endif %}
  </section>

  {%- if p.skills and p.skills.length %}
  <section class="project-detail__section">
    <h{{ h }}>Skills used</h{{ h }}>
    <ul class="chips">{% for s in p.skills %}{{ chip(s) }}{% endfor %}</ul>
  </section>
  {%- endif %}

  {%- if p.fits and p.fits.length %}
  <section class="project-detail__section">
    {#- 'fits' is inferred from the scope of work (projects.json → fit_inferred). -#}
    <h{{ h }}>Good fit if you study <span class="eyebrow__note">(suggested)</span></h{{ h }}>
    <ul class="chips">{% for f in p.fits %}{{ chip(f, "gold") }}{% endfor %}</ul>
  </section>
  {%- endif %}

  <section class="project-detail__section">
    <h{{ h }}>Team</h{{ h }}>
    {%- if (p.team.size | isTbd) and (p.team.roles | isTbd) and (p.team.majors | isTbd) %}
    {{ tbdBlock("Team details coming soon", "[TBD: team size, roles and majors]") }}
    {%- else %}
    <dl class="project-detail__meta">
      <div><dt>Size</dt><dd>{{ (p.team.size | string) if p.team.size else "[TBD: team size]" | tbd | safe }}</dd></div>
      <div><dt>Roles</dt><dd>{{ p.team.roles | join(", ") if p.team.roles.length else "[TBD: roles]" | tbd | safe }}</dd></div>
      <div><dt>Majors</dt><dd>{{ p.team.majors | join(", ") if p.team.majors.length else "[TBD: majors]" | tbd | safe }}</dd></div>
    </dl>
    {%- endif %}
  </section>

  {%- if p.links and p.links.length %}
  <section class="project-detail__section">
    <h{{ h }}>Links</h{{ h }}>
    <ul class="link-list">{% for l in p.links %}<li><a href="{{ l.url }}" rel="noopener">{{ l.label }}</a></li>{% endfor %}</ul>
  </section>
  {%- endif %}
</article>
{%- endmacro %}
