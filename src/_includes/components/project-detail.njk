{%- from "components/ui.njk" import chip with context -%}
{%- from "components/logo-tile.njk" import logoTile with context -%}
{#- Full client story (SPEC 6), the single source for the dialog and /projects/<id>/.
    Header: logo banner; title + (semester label); labelled fields in one row (stacked at 640px
    and below): Client (only when it differs from the title, p.clientDiffers), Client type,
    Disciplines (outlined pills); "Also for <client>" links (parallel projects).
    Then one block per ENGAGEMENT, newest first: tagline, Impact (or Outcome once one is
    written), What we delivered (deliverables, else scope), Skills used, the client quote (only
    with permission) and the public link. Only tiles with several engagements get a semester
    (and title) heading per block; a single engagement's semester is already in the title.
    Then Good fit if you study, Links.
    Not rendered (kept in projects.json): challenge, approach, scope_detail, team; see
    DECISIONS.md. Empty fields are omitted in every mode, with no TBD boxes.
    titleLevel: 1 on the page, 2 in the dialog. Section headings sit one level below the
    engagement heading when there is one, otherwise directly below the title (no skipped levels). -#}
{% macro section(label, h, cls = "") -%}
<section class="project-detail__section {{ cls }}">
  <h{{ h }} class="project-detail__label">{{ label | safe }}</h{{ h }}>
  {{ caller() }}
</section>
{%- endmacro %}

{% macro projectDetail(p, titleLevel = 2) -%}
{%- set h = titleLevel + 1 -%}
{%- set notes = env.showPlaceholders -%}
{%- set multi = p.engagements.length > 1 -%}
<article class="project-detail">
  {{ logoTile(p, "banner") }}
  <header class="project-detail__head">
    <h{{ titleLevel }} class="project-detail__title" data-detail-title tabindex="-1">{{ p.title }} <span class="project-detail__term">({{ p.semester }})</span></h{{ titleLevel }}>
    {#- Labelled fields: Client (only when it differs from the title), Client type, Disciplines. -#}
    <dl class="project-detail__meta">
      {%- if p.clientDiffers %}<div><dt>Client</dt><dd>{{ p.client }}</dd></div>{% endif %}
      {%- if p.client_type %}<div><dt>Client type</dt><dd>{{ p.client_type }}</dd></div>{% endif %}
      {%- if p.disciplines and p.disciplines.length %}<div class="project-detail__disciplines"><dt>Disciplines</dt><dd><ul class="chips">{% for d in p.disciplines %}{{ chip(d, "outline") }}{% endfor %}</ul></dd></div>{% endif %}
    </dl>
    {%- if p.related and p.related.length %}
    <p class="project-detail__related">Also for {{ p.client }}:
      {%- for r in p.related %} <a href="{{ r.url }}" data-project-open="{{ r.id }}">{{ r.title }}</a>{% if not loop.last %},{% endif %}{% endfor %}
    </p>
    {%- endif %}
  </header>

  <div class="project-detail__body">
    {%- set sh = h + 1 if multi else h %}
    {%- for e in p.engagements %}
    {%- set tag = "section" if multi else "div" %}
    <{{ tag }} class="engagement"{% if multi %} aria-labelledby="eng-{{ p.id }}-{{ loop.index }}"{% endif %}>
      {%- if multi %}
      <h{{ h }} class="engagement__heading" id="eng-{{ p.id }}-{{ loop.index }}"><span class="engagement__semester">{{ e.semester }}</span>{% if e.title %}<span class="engagement__title">{{ e.title }}</span>{% endif %}</h{{ h }}>
      {%- endif %}
      {%- if not (e.tagline | isTbd) %}<p class="engagement__tagline">{{ e.tagline }}</p>{% endif %}

      {%- if e.result %}{% call section(e.result.label, sh) %}<p>{{ e.result.text }}</p>{% endcall %}{% endif %}

      {%- if e.delivered.length %}{% call section("What we delivered", sh) %}
        <ul class="checklist">{% for s in e.delivered %}<li>{{ s }}</li>{% endfor %}</ul>
      {% endcall %}{% endif %}

      {%- if e.skills and e.skills.length %}{% call section("Skills used", sh) %}<ul class="chips">{% for s in e.skills %}{{ chip(s) }}{% endfor %}</ul>{% endcall %}{% endif %}

      {%- if e.quoteShown %}
      <figure class="project-detail__quote">
        <blockquote><p>{{ e.quoteShown.text }}</p></blockquote>
        {%- if e.quoteShown.attribution %}<figcaption>{{ e.quoteShown.attribution }}</figcaption>{% endif %}
      </figure>
      {%- endif %}

      {%- if e.linkShown %}<p class="project-detail__link"><a href="{{ e.linkShown }}" rel="noopener">View the public project</a></p>{% endif %}
    </{{ tag }}>
    {%- endfor %}

    <div class="project-detail__shared">
    {#- 'fits' is inferred from the scope of work (projects.json → fit_inferred), so it is labeled as a suggestion. -#}
    {%- if p.fits and p.fits.length %}{% call section('Good fit if you study <span class="eyebrow__note">(suggested)</span>', h) %}<ul class="chips">{% for f in p.fits %}{{ chip(f, "gold") }}{% endfor %}</ul>{% endcall %}{% endif %}

    {%- if p.links and p.links.length %}{% call section("Links", h) %}<ul class="link-list">{% for l in p.links %}<li><a href="{{ l.url }}" rel="noopener">{{ l.label }}</a></li>{% endfor %}</ul>{% endcall %}{% endif %}
    </div>
  </div>
</article>
{%- endmacro %}
