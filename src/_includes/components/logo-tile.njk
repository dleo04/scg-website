{#- Client logo tile, shared by the "Our Work" card ("card") and the project dialog /
    project page banner ("banner"). The logo (projects.json → logo) is shown unaltered,
    contained and centred on a tile filled with logo_bg. Without a logo file:
    - live site: the client's name, typeset on a neutral tile (real content, no note);
    - SHOW_PLACEHOLDERS=1: a labeled placeholder so the team sees what to supply. -#}
{% macro logoTile(p, variant = "card") -%}
{%- set cls = "work-card__logo-tile" if variant == "card" else "project-banner" -%}
{%- if p.logoImg %}
<div class="{{ cls }} {{ cls }}--{{ p.logoImg.shape }}" style="--tile-bg: {{ p.logo_bg }}; --logo-max-h: {{ p.logoImg.maxH }}px; --off-x: {{ p.logo_offset.x if p.logo_offset else 0 }}; --off-y: {{ p.logo_offset.y if p.logo_offset else 0 }}">
  <picture>
    <source type="image/webp" srcset="{{ p.logoImg.webp }}">
    <img src="{{ p.logoImg.png }}" width="{{ p.logoImg.width }}" height="{{ p.logoImg.height }}" alt="{{ p.logoImg.alt }}" loading="lazy" decoding="async">
  </picture>
</div>
{%- elif env.showPlaceholders %}
<div class="{{ cls }} {{ cls }}--missing" style="--tile-bg: var(--ph-bg)" data-placeholder="true" data-todo="[TBD: logo for {{ p.client }} (projects.json → logo, logo_bg)]">
  <span class="ph__label">LOGO: {{ p.client }}</span>
</div>
{%- else %}
<div class="{{ cls }} {{ cls }}--name" style="--tile-bg: {{ p.logo_bg or 'var(--paper-2)' }}" aria-hidden="true">
  <span class="logo-tile__name">{{ p.client }}</span>
</div>
{%- endif %}
{%- endmacro %}
