{#- Banner behind an inner page's header (eyebrow, H1, intro). Used by /projects/, /join/,
    /join/prepare/, /about/ and every page on layouts/stub.njk (team, alumni, work-with-us,
    partners). Not used by project detail pages or the Home hero.
    With a photo (site.json → page_banners → source found under assets/; crops made by
    scripts/make-banners.mjs): the photo under the flat maroon-black tint. Three crops via
    <picture>: desktop ≥1024px and tablet 768-1023px (the chosen band), mobile <768px (the band
    expanded to 16:9). Decorative (alt=""), above the fold, so not lazy-loaded.
    Without a photo: the plain maroon-black gradient (page-banner--plain), same height and text.
    Optional caller() content (e.g. the /join/ status card) sits in a side column; `before`
    renders above the eyebrow (e.g. breadcrumbs). -#}
{% macro pageBanner(opts) -%}
{%- set b = pageBanners[page.url] -%}
{%- set photo = (b.photo == true) if b else false -%}
<section class="page-banner{% if not photo %} page-banner--plain{% endif %}{% if caller %} page-banner--aside{% endif %}" aria-labelledby="{{ opts.id }}" style="--banner-tint: {{ b.tint if b else 0.78 }};{% if photo %} --banner-focal: {{ b.focal }};{% endif %}">
  {%- if photo %}
  <picture class="page-banner__bg">
    <source media="(min-width: 1024px)" type="image/webp" srcset="{{ b.files.desktop.webp }}" sizes="{{ b.files.desktop.sizes }}">
    <source media="(min-width: 1024px)" srcset="{{ b.files.desktop.jpg }}" sizes="{{ b.files.desktop.sizes }}">
    <source media="(min-width: 768px)" type="image/webp" srcset="{{ b.files.tablet.webp }}" sizes="{{ b.files.tablet.sizes }}">
    <source media="(min-width: 768px)" srcset="{{ b.files.tablet.jpg }}" sizes="{{ b.files.tablet.sizes }}">
    <source type="image/webp" srcset="{{ b.files.mobile.webp }}" sizes="{{ b.files.mobile.sizes }}">
    <img src="{{ b.files.mobile.fallback }}" srcset="{{ b.files.mobile.jpg }}" sizes="{{ b.files.mobile.sizes }}" width="{{ b.files.mobile.width }}" height="{{ b.files.mobile.height }}" alt="" fetchpriority="high" decoding="async">
  </picture>
  {%- endif %}
  <div class="container page-banner__inner">
    <div class="page-banner__text">
      {%- if opts.before %}{{ opts.before | safe }}{% endif %}
      <p class="eyebrow page-banner__eyebrow">{{ opts.eyebrow }}</p>
      <h1 class="page-title page-banner__title" id="{{ opts.id }}">{{ opts.title }}</h1>
      {%- if opts.lede %}<p class="lede page-banner__lede">{{ opts.lede }}</p>{% endif %}
    </div>
    {%- if caller %}<div class="page-banner__aside">{{ caller() }}</div>{% endif %}
  </div>
</section>
{%- endmacro %}
