{#- Line icons for /work-with-us/ (24px grid, 1.75 stroke, currentColor). -#}
{% macro wwuIcon(name, size = 24) -%}
<svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
  {%- if name == "research" %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.3 15.3L21 21M7.5 9h6M7.5 12h4"/>
  {%- elif name == "data" %}<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7.5 16.5v-4M12 16.5v-8M16.5 16.5v-6"/>
  {%- elif name == "ai" %}<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9.5 9.5h5v5h-5zM9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3"/>
  {%- elif name == "process" %}<rect x="3" y="4" width="6" height="5" rx="1"/><rect x="15" y="4" width="6" height="5" rx="1"/><rect x="9" y="15" width="6" height="5" rx="1"/><path d="M9 6.5h6M18 9v3.5H12V15"/>
  {%- elif name == "marketing" %}<path d="M3 10v4h3l6 4V6L6 10H3z"/><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"/>
  {%- elif name == "business" %}<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 12.5h18M10.5 12.5v1.5h3v-1.5"/>
  {%- elif name == "campus" %}<path d="M3 10l9-6 9 6"/><path d="M5 10v9M19 10v9M9 19v-6h6v6M3 20h18"/>
  {%- elif name == "nonprofit" %}<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
  {%- elif name == "calendar" %}<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M7.5 14h3M7.5 17h6"/>
  {%- elif name == "diagnostic" %}<path d="M9 4h6v3H9z"/><path d="M15 5.5h2a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6.5a1 1 0 0 1 1-1h2"/><path d="M9 12l2 2 4-4M9 17h6"/>
  {%- elif name == "plan" %}<path d="M4 6h9M4 12h9M4 18h9"/><path d="M16 5l1.5 1.5L20 4M16 11l1.5 1.5L20 10M16 17l1.5 1.5L20 16"/>
  {%- elif name == "meeting" %}<circle cx="8" cy="8" r="3"/><circle cx="16.5" cy="9" r="2.5"/><path d="M2.5 19c.5-3.2 2.7-5 5.5-5s5 1.8 5.5 5M13.5 14.6c.9-.7 1.9-1.1 3-1.1 2.4 0 4.2 1.6 4.6 4.5"/>
  {%- elif name == "link" %}<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7L11.5 6.8"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1.5-1.5"/>
  {%- elif name == "mail" %}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5L12 13l8.5-6.5"/>
  {%- elif name == "instagram" %}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".6" fill="currentColor"/>
  {%- elif name == "linkedin" %}<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.5v.01M11.5 17v-6.5M11.5 13c0-1.7 1.2-2.7 2.6-2.7 1.5 0 2.4 1 2.4 2.9V17"/>
  {%- elif name == "check" %}<path d="M5 12.5l4.5 4.5L19 7.5"/>
  {%- endif -%}
</svg>
{%- endmacro %}
