{#- "Our Work" case-study card (docs/HOME-LAYOUT.md block 4), sized to the reference's
    proportions. Image area: the shared logo tile (components/logo-tile.njk): the client
    logo on its logo_bg, or the client name on a neutral tile when no logo exists yet.
    Rows: Objective = tagline (max 2 lines), Scope = first two scope items
    joined into one line (max 2 lines), Impact = outcome (max 2 lines) or a muted
    "Results coming soon". Skills stay in the dialog and on the project page.
    The title link goes to /projects/<id>/ and, with JS, opens the project dialog. -#}
{%- from "components/logo-tile.njk" import logoTile with context -%}
{% macro workCard(p, number, headingLevel = 3) -%}
<article class="work-card">
  <div class="work-card__media">
    {{ logoTile(p, "card") }}
  </div>
  <div class="work-card__body">
    <h{{ headingLevel }} class="work-card__title">
      <a class="card__link" href="{{ p.url }}" data-project-open="{{ p.id }}">{{ p.title }} <span class="work-card__term">({{ p.semester }})</span></a>
    </h{{ headingLevel }}>
    <dl class="work-card__rows">
      <div class="work-card__row">
        <dt><span class="work-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="0.8" fill="currentColor"/></svg></span>Objective</dt>
        <dd class="clamp clamp--2">{{ p.tagline | tbd | safe }}</dd>
      </div>
      <div class="work-card__row">
        <dt><span class="work-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M9 6h11M9 12h11M9 18h11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="4.5" cy="6" r="1.4" fill="currentColor"/><circle cx="4.5" cy="12" r="1.4" fill="currentColor"/><circle cx="4.5" cy="18" r="1.4" fill="currentColor"/></svg></span>Scope</dt>
        <dd class="clamp clamp--2">
          {%- if (p.scope | isTbd) and env.showPlaceholders %}<span class="tbd" data-placeholder="true" data-todo="[TBD: scope for {{ p.title }}]">[TBD: scope]</span>
          {%- else %}{{ p | scopeLine | tbd | safe }}{% endif -%}
        </dd>
      </div>
      {#- Impact always shows: the outcome, or the public line "Results coming soon". -#}
      {%- if true %}
      <div class="work-card__row">
        <dt><span class="work-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M4 18l5-5 4 3 7-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 8h5v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Impact</dt>
        {%- if p.outcome | isTbd %}
        <dd class="work-card__pending"{% if env.showPlaceholders %} data-placeholder="true" data-todo="[TBD: outcome for {{ p.title }} (projects.json → outcome)]"{% endif %}>Results coming soon</dd>
        {%- else %}
        <dd class="clamp clamp--2">{{ p.outcome | tbd | safe }}</dd>
        {%- endif %}
      </div>
      {%- endif %}
    </dl>
    <span class="work-card__more" aria-hidden="true">Read more <span class="arrow">→</span></span>
  </div>
</article>
{%- endmacro %}
