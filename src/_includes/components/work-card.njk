{#- "Our Work" case-study card (docs/HOME-LAYOUT.md block 4), sized to the reference's
    proportions. Image area: the shared logo tile (components/logo-tile.njk): the client
    logo on its logo_bg, or the client name on a neutral tile when no logo exists yet.
    Rows (every card): Objective = tagline (max 2 lines); Impact = the newest engagement's
    impact line, or its outcome (labelled "Outcome") once one is written (max 2 lines), and a
    muted "Results coming soon" only when both are empty; Skills = up to 4 skills of the newest
    engagement as pills, at most 2 rows. The full deliverables/scope list stays in the dialog
    and on the project page.
    The title link goes to /projects/<id>/ and, with JS, opens the project dialog.
    variant "home" (Home "Our Work" only): the title uses the client name when it is shorter
    than the tile title (e.g. "DefenX"). -#}
{%- from "components/logo-tile.njk" import logoTile with context -%}
{% macro workCard(p, number, headingLevel = 3, variant = "default") -%}
{%- set home = variant == "home" -%}
<article class="work-card">
  <div class="work-card__media">
    {{ logoTile(p, "card") }}
  </div>
  <div class="work-card__body">
    <h{{ headingLevel }} class="work-card__title">
      <a class="card__link" href="{{ p.url }}" data-project-open="{{ p.id }}">{{ p.client if (home and p.client and p.client | length < p.title | length) else p.title }} <span class="work-card__term">({{ p.semester }})</span></a>
    </h{{ headingLevel }}>
    <dl class="work-card__rows">
      <div class="work-card__row">
        <dt><span class="work-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="0.8" fill="currentColor"/></svg></span>Objective</dt>
        <dd class="clamp clamp--2">{{ p.tagline | tbd | safe }}</dd>
      </div>
      {#- Impact: outcome or impact, else "Results coming soon". -#}
      <div class="work-card__row">
        <dt><span class="work-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M4 18l5-5 4 3 7-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 8h5v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{{ p.result.label if p.result else "Impact" }}</dt>
        {%- if p.result %}
        <dd class="clamp clamp--2">{{ p.result.text }}</dd>
        {%- else %}
        <dd class="work-card__pending"{% if env.showPlaceholders %} data-placeholder="true" data-todo="[TBD: impact for {{ p.title }} (projects.json → impact)]"{% endif %}>Results coming soon</dd>
        {%- endif %}
      </div>
      {%- set skills = (p.engagements[0].skills if p.engagements and p.engagements[0].skills else []) %}
      {%- if skills.length %}
      <div class="work-card__row work-card__row--skills">
        <dt><span class="work-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M14.5 5.5l4 4M4 20l1-4.5L15.5 5a1.4 1.4 0 0 1 2 0l1.5 1.5a1.4 1.4 0 0 1 0 2L8.5 19 4 20z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span>Skills</dt>
        <dd><ul class="work-card__skills">{% for s in skills.slice(0, 4) %}<li class="seat-skill">{{ s }}</li>{% endfor %}</ul></dd>
      </div>
      {%- endif %}
    </dl>
    <span class="work-card__more" aria-hidden="true">Read more <span class="arrow">→</span></span>
  </div>
</article>
{%- endmacro %}
