{%- from "components/project-detail.njk" import projectDetail with context -%}
{#- Project detail dialog (SPEC 6). One native <dialog> per page, plus one <template>
    per project rendered with the same macro as /projects/<id>/. src/js/project-dialog.js
    wires it to any link with data-project-open="<id>". Order of templates = prev/next order. -#}
{% macro projectDialog(projects) -%}
<dialog class="project-dialog" id="project-dialog" aria-labelledby="project-dialog-title">
  <div class="project-dialog__panel">
    <div class="project-dialog__bar">
      <div class="project-dialog__nav">
        <button class="icon-btn" type="button" data-dialog-prev aria-label="Previous project">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <span class="project-dialog__pos" data-dialog-position></span>
        <button class="icon-btn" type="button" data-dialog-next aria-label="Next project">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <a class="project-dialog__full" href="/projects/" data-dialog-full>Open full page</a>
      <button class="icon-btn" type="button" data-dialog-close aria-label="Close project details">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="project-dialog__body" data-dialog-body></div>
  </div>
</dialog>
{%- for p in projects %}
<template data-project-template="{{ p.id }}" data-project-url="{{ p.url }}" data-project-title="{{ p.title }}">
  {{ projectDetail(p, 2) }}
</template>
{%- endfor %}
<script src="{{ '/js/project-dialog.js' | versioned }}" defer></script>
{%- endmacro %}
