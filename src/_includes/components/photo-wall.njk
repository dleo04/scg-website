{#- Photo mosaic + accessible lightbox (data/photos.json; images made by npm run old-photos).
    Without JS every tile is a plain link to the full-size JPEG. With JS (lightbox.js) the
    tile opens a native modal <dialog>: focus stays inside, Esc closes, Left/Right move,
    the caption and "n of N" are shown and focus returns to the tile on close.
    Tiles are cropped with object-fit in the grid only; the lightbox shows the whole photo. -#}
{% macro photoWall(photos, id = "photos") -%}
<ul class="photo-wall" data-lightbox-group="{{ id }}">
  {%- for p in photos %}
  {%- set shape = "tall" if p.height > p.width else ("wide" if loop.index0 % 5 == 0 else "") %}
  <li class="photo-wall__item{% if shape %} photo-wall__item--{{ shape }}{% endif %}">
    <a class="photo-wall__link" href="{{ p.full }}" data-lightbox-item data-caption="{{ p.caption }}" data-full="{{ p.full }}" data-width="{{ p.width }}" data-height="{{ p.height }}">
      <picture>
        <source type="image/webp" srcset="{{ p.webpSrcset }}" sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw">
        <img src="{{ p.src }}" srcset="{{ p.jpgSrcset }}" sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" width="{{ p.width }}" height="{{ p.height }}" alt="{{ p.alt }}" loading="lazy" decoding="async">
      </picture>
      <span class="photo-wall__zoom" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </a>
  </li>
  {%- endfor %}
</ul>
<dialog class="lightbox" id="{{ id }}-lightbox" aria-labelledby="{{ id }}-lightbox-caption" data-lightbox>
  <div class="lightbox__bar">
    <span class="lightbox__count" data-lightbox-count aria-hidden="true"></span>
    <button class="icon-btn lightbox__btn" type="button" data-lightbox-close aria-label="Close photo viewer">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
    </button>
  </div>
  <figure class="lightbox__figure">
    <img class="lightbox__img" data-lightbox-img alt="">
    <figcaption class="lightbox__caption" id="{{ id }}-lightbox-caption" data-lightbox-caption></figcaption>
  </figure>
  <button class="icon-btn lightbox__btn lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Previous photo">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button class="icon-btn lightbox__btn lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Next photo">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</dialog>
<script src="{{ '/js/lightbox.js' | versioned }}" defer></script>
{%- endmacro %}
