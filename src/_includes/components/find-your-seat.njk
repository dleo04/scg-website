{%- from "components/ui.njk" import media, chip with context -%}
{#- "Find your seat" role tracks (SPEC 5.2), from data/tracks.json.
    Without JS every track is shown stacked; site.js upgrades this to ARIA tabs.
    "fits" is a suggested mapping copied from projects.json "fits" (fit_inferred: true);
    it is labeled as a suggestion and never claims members of a major did this work. -#}
{% macro findYourSeat(tracks, idPrefix = "seat", headingLevel = 3) -%}
<div class="tracks" data-tabs>
  <div class="tracks__tablist" data-tablist aria-label="Role tracks">
    {%- for t in tracks %}
    <button class="tracks__tab" type="button" id="{{ idPrefix }}-tab-{{ t.slug }}" data-tab="{{ idPrefix }}-panel-{{ t.slug }}">{{ t.name }}</button>
    {%- endfor %}
  </div>
  {%- for t in tracks %}
  <section class="tracks__panel" id="{{ idPrefix }}-panel-{{ t.slug }}" data-panel aria-labelledby="{{ idPrefix }}-heading-{{ t.slug }}">
    <div class="tracks__intro">
      <h{{ headingLevel }} class="tracks__name" id="{{ idPrefix }}-heading-{{ t.slug }}">{{ t.name }}</h{{ headingLevel }}>
      <p class="tracks__summary">{{ t.summary | tbd | safe }}</p>
      <div class="tracks__art">{{ media(t.illustration, "", "ILLUSTRATION: " ~ t.name ~ " (1:1)", "1 / 1") }}</div>
    </div>
    <div class="tracks__detail">
      <h{{ headingLevel + 1 }} class="eyebrow">What you'd do</h{{ headingLevel + 1 }}>
      <ul class="checklist">
        {%- for item in t.what_you_do %}
        <li>
          {{ item.text | tbd | safe }}
          {%- if item.projectData %} <span class="checklist__source"><span class="visually-hidden">(from the </span>{{ item.projectData.title }}<span class="visually-hidden"> project)</span></span>{% endif %}
        </li>
        {%- endfor %}
      </ul>
      <div class="tracks__cols">
        <div>
          <h{{ headingLevel + 1 }} class="eyebrow">Skills you'd build</h{{ headingLevel + 1 }}>
          <ul class="chips">{% for s in t.skills %}{{ chip(s) }}{% endfor %}</ul>
        </div>
        <div>
          <h{{ headingLevel + 1 }} class="eyebrow">Good fit if you study <span class="eyebrow__note">(suggested)</span></h{{ headingLevel + 1 }}>
          <ul class="chips">{% for f in t.fits %}{{ chip(f, "gold") }}{% endfor %}</ul>
        </div>
      </div>
      {% if t.projects.length -%}
      <p class="tracks__projects">
        <span class="tracks__projects-label">Projects in this track:</span>
        {% for p in t.projects -%}
        <a href="{{ p.url }}">{{ p.title }}</a>{% if not loop.last %}<span aria-hidden="true"> · </span>{% endif %}
        {%- endfor %}
      </p>
      {%- endif %}
    </div>
  </section>
  {%- endfor %}
</div>
{%- endmacro %}
