{%- from "components/work-card.njk" import workCard with context -%}
{%- from "components/ui.njk" import chip with context -%}
{#- "Find your seat" (SPEC 5.2) for /join/, from data/tracks.json + data/projects.json.
    With JS (src/js/seat-matcher.js): four equal selector tiles (icon, name, one line; WAI-ARIA tabs:
    Left/Right, Home/End, roving tabindex) and ONE detail panel for the selected track (the
    first track in data/tracks.json is selected when the page opens). Deep link: /join/#track=<slug>.
    Without JS: the tiles are hidden and the four panels are plain stacked sections.
    Panel = name + one-line description (shown only in the no-JS stacked view; with the tabs the
    selected tile already shows both, so the name stays as a visually hidden h3 for the heading
    outline and the description is hidden), 3 "What you'd do" items (panel: true) beside "Good
    fit if you study or enjoy" as gold pills (5 fits, copied from projects' inferred fits; never
    a claim that people of a major did this work), up to 3 project cards (same card as
    /projects/) and a link to /projects/ filtered by the track. -#}
{% macro trackIcon(slug) -%}
<svg class="seat-icon" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
  {%- if slug == "data-engineering" %}<ellipse cx="10" cy="5.5" rx="6.5" ry="2.5"/><path d="M3.5 5.5v9c0 1.4 2.9 2.5 6.5 2.5"/><path d="M3.5 10c0 1.4 2.9 2.5 6.5 2.5s6.5-1.1 6.5-2.5V5.5"/><path d="M14 21v-4M17.5 21v-6.5M21 21v-9"/>
  {%- elif slug == "strategy-research" %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.3 15.3L21 21"/><path d="M7.5 12l2-2.2 1.8 1.6 2.2-2.9"/>
  {%- elif slug == "product-design" %}<rect x="3" y="4" width="13" height="16" rx="2"/><path d="M3 9h13M8 9v11"/><path d="M19.5 6.5l1.5 1.5-6 6H13.5v-1.5z"/>
  {%- else %}<circle cx="8.5" cy="8" r="3"/><path d="M3 19c.4-3.1 2.6-5 5.5-5s5.1 1.9 5.5 5"/><circle cx="17.5" cy="15.5" r="2.2"/><path d="M17.5 11.6v1.5M17.5 17.9v1.5M21.4 15.5h-1.5M15.1 15.5h-1.5M20.3 12.7l-1.1 1.1M15.8 17.2l-1.1 1.1M20.3 18.3l-1.1-1.1M15.8 13.8l-1.1-1.1"/>{% endif -%}
</svg>
{%- endmacro %}

{% macro seatMatcher(tracks) -%}
<div class="seat" data-seat>
  <div class="seat-tiles" role="tablist" aria-label="Tracks" data-seat-tiles hidden>
    {%- for t in tracks %}
    <button class="seat-tile" type="button" role="tab" id="seat-tab-{{ t.slug }}" aria-controls="seat-panel-{{ t.slug }}" {% set isDefault = loop.first %}aria-selected="{{ 'true' if isDefault else 'false' }}" tabindex="{{ 0 if isDefault else -1 }}"{% if isDefault %} data-seat-default{% endif %} data-seat-tab="{{ t.slug }}">
      <span class="seat-tile__icon">{{ trackIcon(t.slug) }}</span>
      <span class="seat-tile__name">{{ t.name }}</span>
      <span class="seat-tile__short">{{ t.short }}</span>
    </button>
    {%- endfor %}
  </div>

  <div class="seat-panels" data-seat-panels>
    {%- for t in tracks %}
    <section class="seat-panel" id="seat-panel-{{ t.slug }}" data-seat-panel="{{ t.slug }}" aria-labelledby="seat-h-{{ t.slug }}">
      <header class="seat-panel__head">
        <span class="seat-panel__icon">{{ trackIcon(t.slug) }}</span>
        <div>
          <h3 class="seat-panel__name" id="seat-h-{{ t.slug }}">{{ t.name }}</h3>
          <p class="seat-panel__short">{{ t.short }}</p>
        </div>
      </header>
      <div class="seat-panel__cols">
        <div>
          <h4 class="seat-panel__label">What you'd do</h4>
          <ul class="checklist seat-panel__do">
            {%- for item in t.panelDo %}<li>{{ item.text }}</li>{% endfor %}
          </ul>
        </div>
        {%- if t.panelFits.length %}
        <div>
          <h4 class="seat-panel__label">Good fit if you study or enjoy</h4>
          <ul class="chips seat-panel__fits">{% for f in t.panelFits %}{{ chip(f, "gold") }}{% endfor %}</ul>
        </div>
        {%- endif %}
      </div>
      {%- if t.showcase.length %}
      <h4 class="seat-panel__label">Work from this track</h4>
      <div class="seat-panel__cards">
        {%- for p in t.showcase %}{{ workCard(p, loop.index, 5) }}{% endfor %}
      </div>
      {%- endif %}
      <p class="seat-panel__more"><a class="link-arrow" href="/projects/?track={{ t.name | urlencode }}">See all projects in this track <span aria-hidden="true">→</span></a></p>
    </section>
    {%- endfor %}
  </div>
</div>
<script src="{{ '/js/seat-matcher.js' | versioned }}" defer></script>
{%- endmacro %}
