{%- from "components/ui.njk" import chip with context -%}
{#- "Find your seat" matcher (SPEC 5.2) for /join/, from data/tracks.json.
    Without JS: the four tracks as a static list (all content visible).
    With JS (seat-matcher.js): pick up to three majors, interests or skills (type-ahead
    combobox or quick chips); tracks whose suggested fits or skills include a pick are shown,
    best match first, with the matching chips highlighted. "I'm not sure" shows all four.
    Source of the terms: each track's 'fits' (copied from the inferred 'fits' of real projects,
    fit_inferred: true) and 'skills'. A match is a suggestion, never a claim that members of
    that major did this work. -#}
{% macro seatMatcher(tracks) -%}
{%- set quick = [] -%}
{%- for t in tracks %}{% for f in t.fits.slice(0, 2) %}{% if f not in quick %}{% set quick = (quick.push(f), quick) %}{% endif %}{% endfor %}{% endfor -%}
<div class="seat" data-seat>
  <div class="seat__finder" data-seat-finder hidden>
    <label class="seat__label" for="seat-input">What do you study or enjoy?</label>
    <p class="seat__hint" id="seat-hint">Type a major, interest or skill, or tap a suggestion. Pick up to three.</p>
    <div class="seat__field" data-seat-field>
      <ul class="seat__picked" data-seat-picked aria-label="Your picks"></ul>
      <input class="seat__input" id="seat-input" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="seat-options" aria-describedby="seat-hint" autocomplete="off" spellcheck="false" data-seat-input>
      <ul class="seat__options" id="seat-options" role="listbox" aria-label="Suggestions" data-seat-options hidden></ul>
    </div>
    <div class="seat__quick">
      <span class="seat__quick-label" id="seat-quick-label">Try</span>
      <ul class="seat__quick-list" aria-labelledby="seat-quick-label">
        {%- for q in quick %}<li><button class="seat__chip" type="button" data-seat-add="{{ q }}">{{ q }}</button></li>{% endfor %}
      </ul>
      <button class="seat__unsure" type="button" data-seat-unsure>I'm not sure yet: show all four tracks</button>
    </div>
    <p class="seat__status" role="status" data-seat-status></p>
  </div>

  <div class="seat__results" data-seat-results>
    {%- for t in tracks %}
    <article class="seat-track seat-track--{{ t.slug }}" id="track-{{ t.slug }}" data-seat-track="{{ t.slug }}" aria-labelledby="track-{{ t.slug }}-name">
      <header class="seat-track__head">
        <span class="seat-track__badge" aria-hidden="true">{{ t.name | first }}</span>
        <div>
          <h3 class="seat-track__name" id="track-{{ t.slug }}-name">{{ t.name }}</h3>
          <p class="seat-track__summary">{{ t.summary }}</p>
        </div>
      </header>
      <p class="seat-track__match" data-seat-match hidden></p>
      <h4 class="seat-track__label">What you'd do</h4>
      <ul class="checklist seat-track__do">
        {%- for item in t.what_you_do %}{% if item.projectData %}
        <li>{{ item.text }} <a class="checklist__source" href="{{ item.projectData.url }}"><span class="visually-hidden">From the project </span>{{ item.projectData.title }}</a></li>
        {%- endif %}{% endfor %}
      </ul>
      <h4 class="seat-track__label">Skills you'd build</h4>
      <ul class="chips">{% for s in t.skills %}<li class="chip" data-term="{{ s }}">{{ s }}</li>{% endfor %}</ul>
      <h4 class="seat-track__label">Good fit if you study or enjoy… <span class="eyebrow__note">(suggested)</span></h4>
      <ul class="chips">{% for f in t.fits %}<li class="chip chip--gold" data-term="{{ f }}">{{ f }}</li>{% endfor %}</ul>
      {%- if t.projects.length %}
      <p class="seat-track__more"><a class="link-arrow" href="/projects/?track={{ t.name | urlencode }}">See the {{ t.projects.length }} projects in this track <span aria-hidden="true">→</span></a></p>
      {%- endif %}
    </article>
    {%- endfor %}
  </div>
  <p class="seat__show-all" data-seat-showall-wrap hidden><button class="link-button" type="button" data-seat-showall>Show all four tracks</button></p>
</div>
<script src="{{ '/js/seat-matcher.js' | versioned }}" defer></script>
{%- endmacro %}
