{%- set pageTitle = (seoTitle if seoTitle else (title ~ " | " ~ site.name)) -%}
{%- set pageDescription = description or site.description -%}
{%- set canonical = page.url | absoluteUrl(site.domain) -%}
{%- set ogImage = (ogImagePath or generatedImages.og.src or "/assets/generated/og-default.png") | absoluteUrl(site.domain) -%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.classList.replace("no-js", "js");</script>
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ canonical }}">
{% if noindex or env.previewNoindex %}<meta name="robots" content="noindex">{% endif %}

<link rel="preload" href="/fonts/lato-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/montserrat-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ '/css/main.css' | versioned }}">

<link rel="icon" href="/assets/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/assets/generated/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#141414">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ ogImageAlt or (site.name ~ ' logo') }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ ogImage }}">

{% include "partials/jsonld-organization.njk" %}
{% if headExtra %}{{ headExtra | safe }}{% endif %}
