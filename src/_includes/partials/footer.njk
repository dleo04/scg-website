{%- from "components/ui.njk" import tbdText with context -%}
<footer class="site-footer">
  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <a class="logo-plate" href="/">
        <img src="/assets/scg-logo.png" width="668" height="184" alt="Snider Consulting Group home" loading="lazy">
      </a>
      <p class="site-footer__tagline">{{ site.tagline }}</p>
    </div>
    <div class="site-footer__aside">
      <p class="site-footer__affiliation">In direct affiliation with the Ed Snider Center for Enterprise and Markets</p>
      {% include "partials/social-links.njk" %}
    </div>
  </div>
  <div class="container">
    <nav aria-label="Footer">
      <ul class="site-footer__links">
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/join/">Join SCG</a></li>
        <li><a href="/join/prepare/">Interview prep</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/team/">Team</a></li>
        <li><a href="/alumni/">Alumni</a></li>
        <li><a href="/partners/">Partners</a></li>
        <li><a href="/work-with-us/">Work With Us</a></li>
      </ul>
    </nav>
    <span class="gold-rule" aria-hidden="true"></span>
    <div class="site-footer__legal">
      <p>© {{ env.year }} Snider Consulting Group</p>
      <p>
        {%- if site.links.contact_email -%}
          <a href="mailto:{{ site.links.contact_email }}">{{ site.links.contact_email }}</a>
        {%- else -%}
          {{ tbdText("[TBD: shared club contact email or contact form]") }}
        {%- endif -%}
      </p>
    </div>
    <p class="site-footer__note">Company names and logos are trademarks of their respective owners and are shown only to indicate where members work.</p>
  </div>
</footer>
