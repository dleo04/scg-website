{#- Site header (docs/HOME-LAYOUT.md). Same nav on every page; About and Partners
    live in the footer. On pages with a hero (bodyClass "has-hero") it starts
    transparent and turns solid on scroll (site.js). -#}
{%- set nav = [
  { label: "Projects", url: "/projects/" },
  { label: "Join SCG", url: "/join/" },
  { label: "Team", url: "/team/" },
  { label: "Alumni", url: "/alumni/" },
  { label: "Work With Us", url: "/work-with-us/" }
] -%}
{#- "Join SCG" goes straight to the application while it is open, otherwise to /join/. -#}
{%- set joinHref = site.recruiting.application_url if (site.recruiting.open and site.recruiting.application_url) else "/join/" -%}
{#- On a hero page that shows the reversed logo, the header logo waits until the hero
    logo has scrolled away (site.js), so two logos are never on screen together. -#}
{%- set deferLogo = brand.reversedLogo and bodyClass and ("has-hero" in bodyClass) -%}
<header class="site-header" data-header{% if deferLogo %} data-logo-deferred{% endif %}>
  <div class="container site-header__inner">
    <a class="site-logo logo-plate" href="/">
      <img src="/assets/scg-logo.png" width="668" height="184" alt="Snider Consulting Group home">
    </a>
    <nav class="site-nav" aria-label="Main">
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
        <span class="nav-toggle__icon" aria-hidden="true"></span>
        <span class="nav-toggle__label">Menu</span>
      </button>
      <ul id="nav-menu" class="nav-menu">
        {%- for item in nav %}
        <li><a class="nav-link" href="{{ item.url }}" {% if page.url.startsWith(item.url) %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
        <li class="nav-menu__social">{% include "partials/social-links.njk" %}</li>
      </ul>
    </nav>
    <div class="header-actions">
      <div class="header-social">{% include "partials/social-links.njk" %}</div>
      <a class="btn btn--sm header-cta" href="{{ joinHref }}"{% if joinHref != "/join/" %} rel="noopener"{% endif %}>Join SCG</a>
    </div>
  </div>
</header>
