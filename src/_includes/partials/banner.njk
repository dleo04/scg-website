{#- Slim recruiting banner, shown only while data/site.json → recruiting.open is true. -#}
{%- if site.recruiting.open -%}
{%- set cta = site.recruiting | ctaState -%}
<aside class="recruit-banner" aria-label="Recruitment">
  <div class="container recruit-banner__inner">
    <p>
      <strong class="recruit-banner__label">{{ site.recruiting.banner_label }}</strong>
      <span>{{ site.recruiting.banner_text }}</span>
      {% if cta.kind != "tbd" -%}
      <a href="{{ cta.href }}" rel="noopener">{{ cta.label }}<span aria-hidden="true"> →</span></a>
      {%- else -%}
      <span class="tbd" data-placeholder="true" data-todo="[TBD link: recruiting.application_url or interest_form_url in data/site.json]">[TBD link]</span>
      {%- endif %}
    </p>
  </div>
</aside>
{%- endif -%}
