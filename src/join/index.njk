---
layout: layouts/base.njk
title: "Join SCG"
description: "Join the Snider Consulting Group at the University of Maryland: recruiting status, the four tracks, what members get, the recruiting calendar and FAQ."
bodyClass: page-join
---
{#- Join (SPEC 5.4). Order: status + CTA → Find your seat → What you get → recruiting
    calendar → interview process + eligibility + FAQ → resources → sticky mobile CTA.
    CTA per SPEC 5.4 (ctaState): Apply while open with an application URL, otherwise the
    interest form, otherwise nothing on the live site. Recruiting status, URLs, calendar and
    benefits come from data/site.json; tracks from data/tracks.json; FAQ from data/faq.json
    (needs_decision items and [TBD] drafts are not published). -#}
{%- from "components/ui.njk" import applyCta, tbdBlock with context -%}
{%- from "components/seat-matcher.njk" import seatMatcher with context -%}
{%- from "components/stepper.njk" import stepper with context -%}
{%- from "components/page-banner.njk" import pageBanner with context -%}
{%- from "components/project-dialog.njk" import projectDialog with context -%}
{%- set cta = site.recruiting | ctaState -%}
{%- set initialStep = 0 -%}
{%- for s in recruitingSteps %}{% if s.status == "current" %}{% set initialStep = loop.index0 %}{% endif %}{% endfor -%}
{%- set faqCount = 0 -%}{%- for g in faq %}{% set faqCount = faqCount + g.items.length %}{% endfor -%}

{% call pageBanner({ id: "join-title", eyebrow: "Recruitment", title: "Join SCG", lede: "Take on real client projects with guidance from EY, and build consulting skills from your first semester." }) %}
    <aside class="status-card" aria-label="Recruiting status">
      <p class="status-card__label"><span class="status-dot{% if site.recruiting.open or cta.kind == 'interest' %} status-dot--live{% endif %}" aria-hidden="true"></span>{{ site.recruiting.banner_label }}</p>
      <p class="status-card__text">{% if site.recruiting.open %}Applications are open.{% else %}{{ site.recruiting.banner_text }}{% endif %}</p>
      {%- if not site.recruiting.open and site.recruiting.closed_text %}<p class="status-card__note">{{ site.recruiting.closed_text }}</p>{% endif %}
      {%- if cta.kind != "tbd" %}
      <a class="btn btn--gold status-card__btn" href="{{ cta.href }}" target="_blank" rel="noopener noreferrer">{{ cta.label }}<span class="visually-hidden"> (opens in a new tab)</span></a>
      {%- else %}{{ applyCta("gold") }}{% endif %}
      {%- if site.recruiting.cycle_note %}<p class="status-card__note">{{ site.recruiting.cycle_note }}</p>{% endif %}
    </aside>
{% endcall %}

<section class="section section--paper-2" aria-labelledby="seat-title" id="find-your-seat">
  <div class="container">
    <header class="section__head">
      <p class="eyebrow">Find your seat</p>
      <h2 class="section__title" id="seat-title">Where would you fit on a project team?</h2>
      <p class="section__lede">SCG projects need four kinds of work. Each track below is written from real client projects.</p>
    </header>
    {{ seatMatcher(tracks, ["Computer Science", "Economics", "Design", "Psychology", "Finance"]) }}
  </div>
</section>

<section class="section" aria-labelledby="benefits-title">
  <div class="container">
    <header class="section__head">
      <p class="eyebrow">What you get</p>
      <h2 class="section__title" id="benefits-title">Membership is free. Here is what it includes.</h2>
    </header>
    <ul class="bento">
      {%- for b in benefits %}
      <li class="bento__item bento__item--{{ b.icon }}">
        <span class="bento__icon" aria-hidden="true">
          {%- if b.icon == "growth" %}<svg viewBox="0 0 24 24"><path d="M4 18l6-6 4 4 6-8"/><path d="M15 8h5v5"/></svg>
          {%- elif b.icon == "network" %}<svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="M11 7.3L6.3 15.8M13 7.3l4.7 8.5M7.5 18h9"/></svg>
          {%- elif b.icon == "projects" %}<svg viewBox="0 0 24 24"><rect x="3.5" y="7" width="17" height="12" rx="2"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M3.5 12.5h17"/></svg>
          {%- elif b.icon == "partner" %}<svg viewBox="0 0 24 24"><path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z"/></svg>
          {%- else %}<svg viewBox="0 0 24 24"><circle cx="8" cy="8" r="3"/><circle cx="16.5" cy="9" r="2.5"/><path d="M2.5 19c.6-3.3 2.8-5 5.5-5s4.9 1.7 5.5 5M13.5 14.3c.9-.5 1.9-.8 3-.8 2.3 0 4.2 1.5 4.7 4.5"/></svg>{% endif -%}
        </span>
        <h3 class="bento__title">{{ b.title }}</h3>
        <p class="bento__text">{{ b.text }}</p>
      </li>
      {%- endfor %}
      {%- set bentoPhoto = photos | findBy("id", "painting-social") %}
      {%- if bentoPhoto %}
      <li class="bento__item bento__item--photo">
        <figure>
          <picture>
            <source type="image/webp" srcset="{{ bentoPhoto.webpSrcset }}" sizes="(min-width: 1024px) 400px, 100vw">
            <img src="{{ bentoPhoto.src }}" srcset="{{ bentoPhoto.jpgSrcset }}" sizes="(min-width: 1024px) 400px, 100vw" width="{{ bentoPhoto.width }}" height="{{ bentoPhoto.height }}" alt="{{ bentoPhoto.alt }}" loading="lazy" decoding="async">
          </picture>
          <figcaption>{{ bentoPhoto.caption }}</figcaption>
        </figure>
      </li>
      {%- endif %}
    </ul>
  </div>
</section>

<section class="section section--ink" aria-labelledby="calendar-title" id="timeline">
  <div class="container">
    <header class="section__head">
      <p class="eyebrow">Recruiting calendar</p>
      <h2 class="section__title" id="calendar-title">How recruiting works</h2>
      <p class="section__lede">{{ site.recruiting.cycle_note }} Select a step to see what happens.</p>
    </header>
    {{ stepper(recruitingSteps, { id: "recruiting", label: "Recruiting steps", headingLevel: 3, initial: initialStep, calendar: true, dark: true }) }}
  </div>
</section>

<section class="section" aria-labelledby="process-title">
  <div class="container join-process">
    <div class="join-process__intro">
      <p class="eyebrow">Interview process</p>
      <h2 class="section__title" id="process-title">Interviews and questions</h2>
      <p>SCG's interview material covers behavioral questions and case interviews. Practice with the sample questions, the case framework guide and the two practice cases.</p>
      <p><a class="btn btn--primary" href="/join/prepare/">Prepare for your interview</a></p>
      {%- if env.showPlaceholders %}{{ tbdBlock("Interview rounds", "[TBD: number of rounds, format and length of each interview]") }}{% endif %}
      <h3 class="join-process__h">Who can apply</h3>
      <p class="join-process__eligibility">SCG recruits new analysts at the start of each fall and spring semester from University of Maryland undergraduates in good academic standing.</p>
      {%- if env.showPlaceholders %}{{ tbdBlock("Eligibility details", "[TBD: confirm the five-semesters-remaining rule before publishing it (faq.json → needs_decision)]") }}{% endif %}
    </div>
    <div class="faq" id="faq" data-faq>
      <h3 class="faq__title" id="faq-title">Frequently asked questions</h3>
      <div class="faq__search" data-faq-search-wrap hidden>
        <label for="faq-q">Search the FAQ</label>
        <input id="faq-q" type="search" autocomplete="off" data-faq-search aria-describedby="faq-count">
        <p class="faq__count" id="faq-count" role="status" data-faq-count></p>
      </div>
      {%- for g in faq %}
      <section class="faq__group" data-faq-group aria-labelledby="faq-g-{{ loop.index }}">
        <h4 class="faq__group-title" id="faq-g-{{ loop.index }}">{{ g.title }}</h4>
        <div class="accordion">
          {%- for item in g.items %}
          <details id="{{ item.id }}" data-faq-item{% if item.unpublished %} data-placeholder="true" data-todo="[TBD: faq.json → &quot;{{ item.q }}&quot; is not published until resolved: {{ item.decision or 'answer still has a [TBD]' }}]"{% endif %}>
            <summary>{{ item.q }}{% if item.unpublished %} <span class="tbd">not published</span>{% endif %}</summary>
            <div class="accordion__body"><p>{{ item.a | tbd | safe }}</p></div>
          </details>
          {%- endfor %}
        </div>
      </section>
      {%- endfor %}
      <p class="faq__empty" data-faq-empty hidden>No questions match. Try another word, or <a href="/about/">read about SCG</a>.</p>
    </div>
  </div>
</section>

<section class="section section--paper-2" aria-labelledby="resources-title">
  <div class="container">
    <header class="section__head">
      <p class="eyebrow">Resources</p>
      <h2 class="section__title" id="resources-title">Get ready to apply</h2>
    </header>
    <ul class="resource-grid">
      {%- if site.links.resume_guide %}
      <li><a class="resource-card" href="{{ site.links.resume_guide }}" target="_blank" rel="noopener noreferrer">
        <span class="resource-card__kind">Slides</span>
        <span class="resource-card__title">Resume guide</span>
        <span class="resource-card__text">SCG's guide to building a strong resume.</span>
        <span class="visually-hidden"> (opens in a new tab)</span>
      </a></li>
      {%- elif env.showPlaceholders %}<li>{{ tbdBlock("Resume guide", "[TBD: site.json → links.resume_guide]") }}</li>{% endif %}
      <li><a class="resource-card" href="/join/prepare/">
        <span class="resource-card__kind">Practice</span>
        <span class="resource-card__title">Interview prep</span>
        <span class="resource-card__text">Sample questions with a timer, the STAR method, and case guides to download.</span>
      </a></li>
      <li><a class="resource-card" href="/projects/">
        <span class="resource-card__kind">Explore</span>
        <span class="resource-card__title">Past projects</span>
        <span class="resource-card__text">Client stories from recent semesters, and the skills each team used.</span>
      </a></li>
    </ul>
  </div>
</section>

{#- Sticky CTA (mobile only): sticks to the bottom of the viewport while the page content
    scrolls, then rests at the end of <main>, so it never covers the footer. -#}
{%- if cta.kind != "tbd" %}
<div class="sticky-cta" data-sticky-cta>
  <span class="sticky-cta__text">{{ site.recruiting.banner_label }}</span>
  <a class="btn btn--gold btn--sm" href="{{ cta.href }}" target="_blank" rel="noopener noreferrer">{{ cta.short }}<span class="visually-hidden"> (opens in a new tab)</span></a>
</div>
{%- endif %}

{#- FAQPage structured data: published questions only (never needs_decision or [TBD] drafts). -#}
{%- set faqLd = { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [] } -%}
{%- for g in faq %}{% for item in g.items %}{% if not item.unpublished %}
{%- set faqLd = (faqLd.mainEntity.push({ "@type": "Question", "name": item.q, "acceptedAnswer": { "@type": "Answer", "text": item.a } }), faqLd) -%}
{%- endif %}{% endfor %}{% endfor %}
<script type="application/ld+json">{{ faqLd | jsonLd | safe }}</script>
<script src="{{ '/js/faq-search.js' | versioned }}" defer></script>
{#- Dialog for the project cards in Find your seat (one template per project shown). -#}
{%- set seatProjects = [] -%}
{%- for t in tracks %}{% for p in t.showcase %}{% if p not in seatProjects %}{% set seatProjects = (seatProjects.push(p), seatProjects) %}{% endif %}{% endfor %}{% endfor -%}
{{ projectDialog(seatProjects) }}
