---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": {{ site.name | dump | safe }},
  "short_name": {{ site.short_name | dump | safe }},
  "description": {{ site.description | dump | safe }},
  "start_url": "{{ '/' | url }}",
  "display": "browser",
  "background_color": "#FFFFFF",
  "theme_color": "#141414",
  "icons": [
    { "src": "{{ '/assets/generated/icon-192.png' | url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/generated/icon-512.png' | url }}", "sizes": "512x512", "type": "image/png" }
  ]
}
