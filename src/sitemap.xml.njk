---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- Every HTML page except those marked noindex (stub pages). Listed in /robots.txt. -#}
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
{%- if item.url and item.url.endsWith("/") and not item.data.noindex %}
  <url><loc>{{ item.url | absoluteUrl(site.domain) }}</loc></url>
{%- endif %}
{%- endfor %}
</urlset>
