---
layout: layouts/base.njk
title: "Services"
description: "SCG consults for University of Maryland clubs, organizations and institutions, and off-campus nonprofits. On-campus services are always free; off-campus nonprofits get low rates."
bodyClass: page-wwu
---
{#- Work With Us → Services. Copy: the old Services page (site.json → work_with_us: intro,
    engagement, more) and the FAQ fee answer (feeFacts, one sentence per card). Service cards:
    work_with_us.help with client logo chips (helpCards, from projects.json skills/tracks).
    Clients: logo tiles (clientTiles) + other names (otherClients) + the verified "Client
    projects" stat. No stepper here (that is /about/). CTA → /work-with-us/contact/. -#}
{%- from "components/page-banner.njk" import pageBanner with context -%}
{%- from "components/wwu-icons.njk" import wwuIcon with context -%}
{%- set wwu = site.work_with_us -%}
{%- set clientStat = site.stats | findBy("label", "Client projects") -%}
{%- set hero = generatedImages.hero -%}

{{ pageBanner({ id: "page-title", title: "Our services", lede: wwu.intro,
  before: '<nav class="breadcrumbs page-banner__crumbs" aria-label="Breadcrumb"><ol><li>Work With Us</li><li aria-current="page">Services</li></ol></nav>' }) }}

{%- if feeFacts.length == 2 and wwu.fee_cards and wwu.fee_cards.length == 2 %}
<section class="section section--tight" aria-labelledby="fees-title">
  <div class="container">
    <h2 class="visually-hidden" id="fees-title">Cost</h2>
    <ul class="fee-grid">
      {%- for card in wwu.fee_cards %}
      {%- set img = generatedImages.feeCards[card.image] if generatedImages.feeCards else null %}
      <li class="fee-card">
        {%- if img %}
        <picture class="fee-card__photo">
          <source type="image/webp" srcset="{{ img.webpSrcset }}" sizes="(min-width: 1248px) 588px, (min-width: 768px) 46vw, 92vw">
          <img src="{{ img.src }}" srcset="{{ img.jpgSrcset }}" sizes="(min-width: 1248px) 588px, (min-width: 768px) 46vw, 92vw" width="{{ img.width }}" height="{{ img.height }}" alt="{{ card.alt }}" loading="lazy" decoding="async" style="object-position: {{ card.focal or '50% 50%' }}">
        </picture>
        {%- endif %}
        <div class="fee-card__body">
          <h3 class="fee-card__title">{{ card.title }}</h3>
          <p class="fee-card__text">{{ feeFacts[loop.index0] }}</p>
        </div>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}

<section class="section section--paper-2" aria-labelledby="help-title">
  <div class="container">
    <header class="section__head">
      <p class="eyebrow">Services</p>
      <h2 class="section__title" id="help-title">What we can help with</h2>
      <p class="section__lede">Drawn from the projects SCG teams have delivered for clients.</p>
    </header>
    {#- Cards share row tracks (subgrid), so titles, descriptions and the footer dividers line up
        across a row. Hyphenated words in titles ("knowledge-management") are kept whole from
        768px (.help-card__word); on phones they may break after their own hyphen so the
        title still fits beside the icon.
        The footer link is a stretched link: its ::after covers the card. -#}
    <ul class="help-grid">
      {%- for h in helpCards %}
      <li class="help-card">
        <div class="help-card__head">
          <span class="icon-chip icon-chip--lg">{{ wwuIcon(h.icon, 24) }}</span>
          <h3 class="help-card__title">{{ h.title | escape | replace(r/(\S+-\S+)/g, '<span class="help-card__word">$1</span>') | safe }}</h3>
        </div>
        <p class="help-card__text">{{ h.text }}</p>
        <div class="help-card__foot">
          {%- if h.link %}<a class="help-card__link" href="{{ h.link }}">See related projects<span class="visually-hidden">: {{ h.title }}</span> <span class="help-card__arrow" aria-hidden="true">→</span></a>{% endif %}
        </div>
      </li>
      {%- endfor %}
    </ul>
    {%- if wwu.more %}
    <div class="help-close">
      <p class="help-close__text">{{ wwu.more }}</p>
      <a class="btn btn--primary help-close__btn" href="/work-with-us/contact/">Request a project</a>
    </div>
    {%- endif %}
  </div>
</section>

<section class="section" aria-labelledby="engage-title">
  {#- Photo left (sticky from 1024px, top aligned with the eyebrow), text right; phones: photo
      on top. Steps 1-4 are an <ol> whose visible numbers are aria-hidden (screen readers
      count the list items themselves); "Beyond the semester" follows as the ongoing outcome. -#}
  {%- set eng = wwu.engagement -%}
  {%- set engImg = generatedImages.engagement -%}
  <div class="container engage{% if not engImg %} engage--no-photo{% endif %}">
    {%- if engImg %}
    <div class="engage__photo">
      <picture>
        <source media="(max-width: 767px)" type="image/webp" srcset="{{ engImg.mobile.webpSrcset }}" sizes="92vw">
        <source media="(max-width: 767px)" srcset="{{ engImg.mobile.jpgSrcset }}" sizes="92vw">
        <source type="image/webp" srcset="{{ engImg.wide.webpSrcset }}" sizes="(min-width: 1248px) 500px, 42vw">
        <img src="{{ engImg.wide.src }}" srcset="{{ engImg.wide.jpgSrcset }}" sizes="(min-width: 1248px) 500px, 42vw" width="{{ engImg.wide.width }}" height="{{ engImg.wide.height }}" alt="{{ eng.alt }}" loading="lazy" decoding="async">
      </picture>
      {%- if eng.badge %}<span class="engage__badge" aria-hidden="true">{{ eng.badge }}</span>{% endif %}
    </div>
    {%- endif %}
    <div class="engage__text">
      <header class="section__head">
        <p class="eyebrow">Working together</p>
        <h2 class="section__title" id="engage-title">{{ eng.title }}</h2>
      </header>
      {%- set steps = eng.items.slice(0, 4) -%}
      {%- set outcome = eng.items[4] -%}
      <ol class="engage-steps">
        {%- for it in steps %}
        <li class="engage-step" data-reveal style="--i: {{ loop.index0 }}">
          <span class="engage-step__marker" aria-hidden="true">{{ loop.index }}</span>
          <div class="engage-step__body">
            <h3 class="engage-step__title">{{ it.title }}</h3>
            <p class="engage-step__text">{{ it.text }}</p>
          </div>
        </li>
        {%- endfor %}
      </ol>
      {%- if outcome %}
      <div class="engage-step engage-step--outcome" data-reveal style="--i: 4">
        <span class="engage-step__marker engage-step__marker--outcome" aria-hidden="true">{{ wwuIcon("link", 18) }}</span>
        <div class="engage-step__body">
          <h3 class="engage-step__title">{{ outcome.title }}</h3>
          <p class="engage-step__text">{{ outcome.text }}</p>
        </div>
      </div>
      {%- endif %}
      <p class="engage__cta"><a class="engage__link" href="/work-with-us/contact/">Request a project <span class="engage__arrow" aria-hidden="true">→</span></a></p>
    </div>
  </div>
</section>

{%- if clientTiles.length %}
<section class="section section--paper-2" aria-labelledby="clients-title">
  <div class="container">
    <header class="section__head">
      <p class="eyebrow">Past clients</p>
      <h2 class="section__title" id="clients-title">Organizations we've worked with</h2>
      {%- if clientStat and clientStat.verified %}<p class="section__lede">{{ clientStat.value }} client projects so far.</p>{% endif %}
    </header>
    <ul class="client-grid">
      {%- for c in clientTiles %}
      <li>
        <a class="client-tile" href="{{ c.url }}" style="--tile-bg: {{ c.logo_bg or '#FFFFFF' }}">
          {%- if c.logoImg %}
          <picture><source type="image/webp" srcset="{{ c.logoImg.webp }}"><img src="{{ c.logoImg.png }}" width="{{ c.logoImg.width }}" height="{{ c.logoImg.height }}" alt="{{ c.name }}" loading="lazy" decoding="async"></picture>
          {%- else %}<span class="client-tile__name">{{ c.name }}</span>{% endif %}
        </a>
      </li>
      {%- endfor %}
    </ul>
    {%- if otherClients.length %}
    <h3 class="client-more__title">More past clients</h3>
    <ul class="client-chips">
      {%- for c in otherClients %}<li>{% if c.url %}<a class="chip" href="{{ c.url }}">{{ c.name }}</a>{% else %}<span class="chip">{{ c.name }}</span>{% endif %}</li>{% endfor %}
    </ul>
    {%- endif %}
  </div>
</section>
{%- endif %}

<section class="cta-band" aria-labelledby="cta-title">
  {%- if hero %}
  <img class="ey-band__bg" src="{{ hero.src }}" srcset="{{ hero.jpgSrcset }}" sizes="100vw" width="{{ hero.width }}" height="{{ hero.height }}" alt="" loading="lazy" decoding="async">
  {%- endif %}
  <div class="container cta-band__inner">
    <h2 class="cta-band__text" id="cta-title">{{ wwu.cta }}</h2>
    <a class="btn btn--white" href="/work-with-us/contact/">Request a project</a>
  </div>
</section>
