---
layout: layouts/base.njk
title: "Work with us"
description: "SCG consults for UMD student organizations, departments and nonprofits. On-campus services are always free; off-campus nonprofits get low rates."
bodyClass: page-wwu
---
{#- Work With Us (SPEC 5.8), for UMD student orgs, departments and nonprofits.
    Intro: site.json → work_with_us.intro + the fee answer from faq.json (one source).
    "What we can help with": work_with_us.help (derived from projects.json skills).
    How a project works: components/process-section.njk (same as /about/).
    Past clients: project logo tiles (clientTiles) + other names from past-clients.json.
    Request form: components/request-form.njk (endpoint or fallback). -#}
{%- from "components/page-banner.njk" import pageBanner with context -%}
{%- from "components/process-section.njk" import processSection with context -%}
{%- from "components/project-dialog.njk" import projectDialog with context -%}
{%- from "components/request-form.njk" import requestForm with context -%}
{%- set wwu = site.work_with_us -%}
{%- set feeAnswer = "" -%}
{%- for g in faq %}{% for item in g.items %}{% if item.q == "How much do SCG services cost?" and not item.unpublished %}{% set feeAnswer = item.a %}{% endif %}{% endfor %}{% endfor -%}
{%- set dialogProjects = [] -%}
{%- for s in processSteps %}{% if s.example and s.example.project %}{% set dialogProjects = (dialogProjects.push(s.example.project), dialogProjects) %}{% endif %}{% endfor -%}
{%- macro helpIcon(name) -%}
<svg class="help-card__icon" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
  {%- if name == "research" %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.3 15.3L21 21M7.5 9h6M7.5 12h4"/>
  {%- elif name == "data" %}<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7.5 16.5v-4M12 16.5v-8M16.5 16.5v-6"/>
  {%- elif name == "ai" %}<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9.5 9.5h5v5h-5zM9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3"/>
  {%- elif name == "process" %}<rect x="3" y="4" width="6" height="5" rx="1"/><rect x="15" y="4" width="6" height="5" rx="1"/><rect x="9" y="15" width="6" height="5" rx="1"/><path d="M9 6.5h6M18 9v3.5H12V15"/>
  {%- elif name == "marketing" %}<path d="M3 10v4h3l6 4V6L6 10H3z"/><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"/>
  {%- else %}<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 12.5h18M10.5 12.5v1.5h3v-1.5"/>{% endif -%}
</svg>
{%- endmacro -%}

{{ pageBanner({ id: "page-title", eyebrow: "For clients", title: "Work with us", lede: wwu.intro }) }}

<section class="section" aria-labelledby="help-title">
  <div class="container">
    <div class="wwu-intro">
      {%- if feeAnswer %}<p class="wwu-intro__fees">{{ feeAnswer }}</p>{% endif %}
      <p><a class="btn btn--primary" href="#request-title">Request a project</a></p>
    </div>
    <header class="section__head">
      <p class="eyebrow">Services</p>
      <h2 class="section__title" id="help-title">What we can help with</h2>
      <p class="section__lede">Drawn from the projects SCG teams have delivered for clients.</p>
    </header>
    <ul class="help-grid">
      {%- for h in wwu.help %}
      <li class="help-card">
        <span class="help-card__badge">{{ helpIcon(h.icon) }}</span>
        <h3 class="help-card__title">{{ h.title }}</h3>
        <p class="help-card__text">{{ h.text }}</p>
        {%- if h.link %}<a class="link-arrow help-card__link" href="{{ h.link }}" aria-label="See related projects: {{ h.title }}">See related projects <span aria-hidden="true">→</span></a>{% endif %}
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

{{ processSection(processSteps) }}

{%- if clientTiles.length %}
<section class="section" aria-labelledby="clients-title">
  <div class="container">
    <header class="section__head">
      <p class="eyebrow">Past clients</p>
      <h2 class="section__title" id="clients-title">Organizations we've worked with</h2>
    </header>
    <ul class="client-grid">
      {%- for c in clientTiles %}
      <li>
        <a class="client-tile" href="{{ c.url }}" style="--tile-bg: {{ c.logo_bg or 'var(--paper-2)' }}">
          {%- if c.logoImg %}
          <picture><source type="image/webp" srcset="{{ c.logoImg.webp }}"><img src="{{ c.logoImg.png }}" width="{{ c.logoImg.width }}" height="{{ c.logoImg.height }}" alt="{{ c.name }}" loading="lazy" decoding="async"></picture>
          {%- else %}<span class="client-tile__name">{{ c.name }}</span>{% endif %}
        </a>
      </li>
      {%- endfor %}
    </ul>
    {%- if otherClients.length %}
    <h3 class="client-more__title">More past clients</h3>
    <ul class="client-more">
      {%- for c in otherClients %}<li>{% if c.url %}<a href="{{ c.url }}">{{ c.name }}</a>{% else %}{{ c.name }}{% endif %}</li>{% endfor %}
    </ul>
    {%- endif %}
  </div>
</section>
{%- endif %}

<section class="section section--paper-2" aria-labelledby="request-title">
  <div class="container request-section">
    <header class="section__head">
      <p class="eyebrow">Get in touch</p>
      <h2 class="section__title" id="request-title">Request a project</h2>
      <p class="section__lede">Tell us about your organization and what you need.</p>
    </header>
    {{ requestForm() }}
  </div>
</section>
{%- if dialogProjects.length %}{{ projectDialog(dialogProjects) }}{% endif %}
