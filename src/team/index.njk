---
layout: layouts/base.njk
title: "Our team"
description: "Meet the Snider Consulting Group's board of trustees and consultants."
bodyClass: page-team
---
{#- /team/ from data/team.json (consent enforced in lib/load-data.js). Grouped by level; filters
    (level, name, and major once at least 3 people have one and team.json → show_majors is true)
    are added by people-filter.js. Majors are data only while show_majors is false.
    Without JS every card is visible. Members with a bio page (/team/<id>/, src/team/person.njk)
    get a "Read bio" link whose hit area covers the whole card, as on /alumni/; LinkedIn is on
    that page, not on the tile. The tile line is the member's headline (the same line as on
    their page), or the old 'experience' line when the headline is blank. headline_company_break:
    the text after the last comma is an inline-block, so the company wraps as one unit (inline
    style, so the shared stylesheet and every other page stay unchanged). -#}
{%- from "components/page-banner.njk" import pageBanner with context -%}
{%- from "components/person.njk" import avatar with context -%}
{{ pageBanner({ id: "page-title", eyebrow: "Who we are", title: "Our team" }) }}
<section class="section section--paper-2 people" aria-label="Team members">
  <div class="container">
    <form class="people-filters" data-people-filters hidden role="search" aria-label="Filter team members" onsubmit="return false">
      <div class="people-filters__field people-filters__field--search">
        <label for="tf-q">Search by name</label>
        <input id="tf-q" name="q" type="search" autocomplete="off">
      </div>
      <div class="people-filters__field">
        <label for="tf-level">Level</label>
        <select id="tf-level" name="level"><option value="">All levels</option>{% for g in team.groups %}<option>{{ g.level }}</option>{% endfor %}</select>
      </div>
      {%- if team.showMajors and team.majors.length >= 3 %}
      <div class="people-filters__field">
        <label for="tf-major">Major</label>
        <select id="tf-major" name="major"><option value="">All majors</option>{% for m in team.majors %}<option>{{ m }}</option>{% endfor %}</select>
      </div>
      {%- endif %}
      <p class="people-filters__count" role="status" aria-live="polite" data-people-count></p>
    </form>
    {%- for g in team.groups %}
    <section class="people-group" data-people-group aria-labelledby="lvl-{{ g.slug }}">
      <h2 class="people-group__title" id="lvl-{{ g.slug }}">{{ g.level }}</h2>
      <ul class="team-grid">
        {%- for p in g.people %}
        {%- set line = p.headline or p.experience %}
        <li class="team-card{% if p.url %} team-card--link{% endif %}"{% if p.url %} id="{{ p.id }}"{% endif %} data-person data-name="{{ p.name }}" data-level="{{ p.level }}" data-majors="{{ p.majors | join('|') if team.showMajors else '' }}" data-search="{{ p.name }} {{ p.title }} {{ line }}">
          <div class="team-card__photo">{{ avatar(p, "avatar--square") }}</div>
          <div class="team-card__body">
            <h3 class="team-card__name">{{ p.name }}</h3>
            <p class="team-card__title">{{ p.title }}</p>
            {%- if p.cohort %}<p class="team-card__cohort">Cohort {{ p.cohort }}</p>{% endif %}
            {%- if team.showMajors and p.majors.length %}<p class="team-card__majors">{{ p.majors | join(", ") }}</p>{% endif %}
            {%- if line %}<p class="team-card__exp">{% set cut = p.headline.lastIndexOf(",") + 1 if (p.headline_company_break and p.headline) else 0 %}{% if cut > 0 %}{{ p.headline.slice(0, cut) }} <span style="display: inline-block">{{ p.headline.slice(cut) | trim }}</span>{% else %}{{ line }}{% endif %}</p>{% endif %}
            {%- if p.workedOn.length %}<ul class="chips team-card__projects" aria-label="Worked on">{% for pr in p.workedOn %}<li><a class="chip" href="{{ pr.url }}">{{ pr.title }}</a></li>{% endfor %}</ul>{% endif %}
            {% if p.url %}<p class="team-card__foot"><a class="team-card__more" href="{{ p.url }}" aria-label="{{ p.name }}, {{ p.title }}: read bio">Read bio <span aria-hidden="true">→</span></a></p>{% endif %}
          </div>
        </li>
        {%- endfor %}
      </ul>
    </section>
    {%- endfor %}
    <p class="people-empty" data-people-empty hidden>No one matches. <button class="link-button" type="button" data-people-clear>Clear filters</button></p>
  </div>
</section>
<script src="{{ '/js/people-filter.js' | versioned }}" defer></script>
