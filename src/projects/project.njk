---
layout: layouts/base.njk
pagination:
  data: projects
  size: 1
  alias: project
permalink: "/projects/{{ project.id }}/"
noindex: true
eleventyComputed:
  title: "{{ project.title }}"
  description: "{{ project.tagline }}"
---
{%- from "components/project-detail.njk" import projectDetail with context -%}
{#- Standalone case study (no-JS fallback for the dialog). Stage 2 adds
    breadcrumbs, BreadcrumbList JSON-LD and per-project Open Graph tags. -#}
<section class="section project-page">
  <div class="container narrow">
    <p class="eyebrow"><a href="/projects/">Projects</a> / {{ project.semester }}</p>
    {{ projectDetail(project, 1) }}
  </div>
</section>
