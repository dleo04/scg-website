{
  "name": "scg-site",
  "version": "1.0.0",
  "description": "Snider Consulting Group website (Eleventy static site)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "assets": "node scripts/make-assets.mjs",
    "dev": "npm run assets && eleventy --serve --port 8080",
    "build": "npm run assets && eleventy && node scripts/check-output.mjs",
    "build:prod": "SCG_ENV=production npm run build",
    "check": "node scripts/check-output.mjs",
    "todo": "npm run build && node scripts/todo.mjs",
    "ui-check": "node scripts/ui-check.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "axe-core": "^4.13.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
